# Local development — copy to .env (do not commit .env with secrets).
# GoDaddy GitHub deploy: set the same keys in Hosting → Secrets (not .env on the server).

# Base URL of the chefdclub_backend REST API (Node.js + Express)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Required on GoDaddy for production builds (example values — use your live API):
# NEXT_PUBLIC_API_URL=https://api.chefdclub.com/api
# NODE_ENV=production

# Cloudflare Turnstile site keys (public)
NEXT_PUBLIC_TURNSTILE_CONTACT_SITE_KEY=
NEXT_PUBLIC_TURNSTILE_RESERVATION_SITE_KEY=

# Do not set PORT=3002 on GoDaddy — the platform sets PORT automatically.

# Dev only: the "API" panel listing server-side API calls (default: on in dev, never in production)
# API_DEBUG=false
# API_DEBUG_FULL=false   cut long lists/strings in the panel (default: show the full bodies)