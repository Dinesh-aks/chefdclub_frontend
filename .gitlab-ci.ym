
stages:
  - build
  - deploy

build_frontend:
  stage: build
  image: node:22-bookworm

  before_script:
    - apt-get update -qq
    - apt-get install -y -qq zip

  script:
    - npm ci

    # Build Next.js (copy-standalone.js configures godaddy-env + start for the zip)
    - npm run build

    # Create deployment ZIP
    - cd .next/standalone
    - zip -qr "$CI_PROJECT_DIR/frontend.zip" .

  artifacts:
    paths:
      - frontend.zip
    expire_in: 1 day

  rules:
    - if: '$CI_COMMIT_BRANCH'

deploy_preview:
  stage: deploy
  image: node:22-bookworm

  needs:
    - job: build_frontend
      artifacts: true

  before_script:
    - apt-get update -qq
    - apt-get install -y -qq curl jq

  script:
    - test -n "$GODADDY_AKS_CHEFDCLUB_FRONTEND"
    - test -n "$GODADDY_APP_ID"

    - export BASE_URL="https://api.godaddy.com/v1/hosting"

    - |
      RESPONSE=$(curl --fail-with-body -sS \
        -X POST "$BASE_URL/apps/$GODADDY_APP_ID/imports" \
        -H "Authorization: Bearer $GODADDY_AKS_CHEFDCLUB_FRONTEND" \
        -F "file=@frontend.zip")

      echo "$RESPONSE" | jq .

      IMPORT_ID=$(echo "$RESPONSE" | jq -r '.importId')

      test -n "$IMPORT_ID"
      test "$IMPORT_ID" != "null"

    - |
      for i in $(seq 1 60); do
        RESPONSE=$(curl --fail-with-body -sS \
          "$BASE_URL/apps/$GODADDY_APP_ID/imports/$IMPORT_ID" \
          -H "Authorization: Bearer $GODADDY_AKS_CHEFDCLUB_FRONTEND")

        STATUS=$(echo "$RESPONSE" | jq -r '.status')

        echo "Import status: $STATUS"

        if [ "$STATUS" = "COMPLETED" ]; then
          echo "Preview import completed."
          break
        fi

        if [ "$STATUS" = "FAILED" ]; then
          echo "$RESPONSE" | jq .
          exit 1
        fi

        if [ "$i" = "60" ]; then
          echo "Import timed out."
          exit 1
        fi

        sleep 5
      done

  rules:
    - if: '$CI_COMMIT_BRANCH'
      when: manual
